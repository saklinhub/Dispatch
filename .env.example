# ==============================================================================
# Dispatch Environment Variables Template
# Copy this file to .env and configure the values for your environment.
# Never commit your actual .env file with secrets into version control!
# ==============================================================================

# --- Application Profile & Port ---
SPRING_PROFILES_ACTIVE=dev
PORT=8080

# --- PostgreSQL Database ---
# For local Docker Compose, default host port is 5433 (mapped to internal 5432).
# In production, use standard internal port 5432 and supply strong credentials.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=dispatch_db
DB_USERNAME=dispatch
DB_PASSWORD=dispatch
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5

# Optional: Override the full JDBC URL directly
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/dispatch_db

# --- RabbitMQ Message Broker ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# --- Security / JWT Configuration (CRITICAL) ---
# MUST be at least 256 bits (32 bytes) for HMAC-SHA256 signing.
# In production, generate a secure random key, for example:
#   openssl rand -base64 48
JWT_SECRET=dispatch-super-secret-key-minimum-256-bits-change-in-prod
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# --- Email Delivery (SMTP) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=noreply@dispatch.io
MAIL_FROM_NAME="Dispatch Notifications"

# --- SMS Delivery (Twilio) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+15555555555
TWILIO_MESSAGING_SERVICE_SID=
SMS_ENABLED=false
